# Luanette on the Waveshare ESP32-S3-Touch-AMOLED-2.06: ESP32-S3R8 (8 MB octal PSRAM),
# 32 MB flash.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Allocations of 64 bytes and up go to PSRAM; what must be internal (DMA buffers, FreeRTOS objects)
# asks for it. Keeps internal RAM for the band buffers and stacks.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=64
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# The USB-C port is the S3's own USB Serial/JTAG: the log and the USB link live there.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# C++ without exceptions or RTTI; the renderer wants speed over size (the slots have room).
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# 60 fps: a 1 ms tick, so a 16.7 ms frame isn't rounded to 10 ms steps.
CONFIG_FREERTOS_HZ=1000
# Code and fonts run from flash through the caches: a 32 KB instruction cache and 64-byte data
# cache lines cut the miss cost (measured with this renderer, 2026-10-12).
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Battery: down to 80 MHz when idle, and light sleep while the screen is dark (the console holds
# it off while lit). A computer on the USB port keeps it awake; a wall charger doesn't.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
# The sleep path in internal RAM: from flash, IDF assumes a wake-up longer than most naps.
CONFIG_PM_SLP_IRAM_OPT=y

# A panic's core dump goes to the `coredump` partition, to read over USB afterwards.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
# `pm` over USB: the power locks, how long each was held, and the time spent asleep.
CONFIG_PM_PROFILING=y
